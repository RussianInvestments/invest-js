{
  "name": "grpc-web-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/grpc-web-client/src",
  "projectType": "library",
  "tags": ["scope:client"],
  "implicitDependencies": ["grpc"],
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "inputs": ["{workspaceRoot}/libs/grpc/proto/**/*.proto"],
      "outputs": ["{projectRoot}/compiled"],
      "cache": true,
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "rm -rf {projectRoot}/compiled",
          "mkdir {projectRoot}/compiled",
          {
            "command": "bash {projectRoot}/tools/generate.sh",
            "description": "Генерация спецификаций для Web на основе GRPC контракта"
          }
        ]
      }
    },
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["generate"],
      "options": {
        "outputPath": "dist/libs/grpc-web-client",
        "main": "libs/grpc-web-client/src/index.ts",
        "tsConfig": "libs/grpc-web-client/tsconfig.lib.json",
        "assets": ["libs/grpc-web-client/*.md"],
        "format": ["esm"],
        "platform": "browser",
        "minify": true,
        "external": ["nice-grpc-web"]
      }
    }
  }
}
