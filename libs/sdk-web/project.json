{
  "name": "sdk-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/sdk-web/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:swc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/sdk-web",
        "main": "libs/sdk-web/src/index.ts",
        "tsConfig": "libs/sdk-web/tsconfig.lib.json",
        "assets": ["libs/sdk-web/*.md"]
      }
    },
    "test": {
      "executor": "nx:run-script",
      "options": {
        "script": "test"
      }
    }
  }
}
